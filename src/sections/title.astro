---
const socialLinks = [
  { label: "GitHub", url: "https://github.com/yangavin" },
  { label: "Let’s connect", url: "https://www.linkedin.com/in/yangavin/" },
];
---

<section class="orbit-hero" aria-labelledby="hero-name" data-orbit-hero>
  <div class="orbital-art" aria-hidden="true">
    <div class="orbit-path"></div>
    <div class="planet blue-planet"></div>
    <div class="planet yellow-planet"></div>
    <div class="planet pink-planet"></div>
  </div>
  <nav class="hero-links" aria-label="Social links">
    {
      socialLinks.map(({ label, url }) => (
        <a href={url} target="_blank" rel="noopener noreferrer">
          {label}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7M7 7h10v10" />
          </svg>
        </a>
      ))
    }
  </nav>
  <div class="hero-identity">
    <p class="degree">Computer Science Student</p>
    <h1 id="hero-name">Gavin Yan</h1>
    <p class="university">Queen’s University</p>
  </div>
</section>

<style>
  .orbit-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 1600px;
    min-height: clamp(34rem, 82svh, 60rem);
    margin-inline: auto;
    padding: 1.75rem clamp(1.5rem, 5vw, 4.5rem) 1.875rem;
    color: #514f49;
  }
  .hero-links {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.625rem;
  }
  .hero-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    min-height: 44px;
    padding-block: 0.5rem;
    font-size: clamp(0.875rem, 1.2vw, 1.125rem);
  }
  .hero-links a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .hero-links a:focus-visible {
    outline: 2px solid #476967;
    outline-offset: 4px;
    border-radius: 2px;
  }
  .hero-links svg {
    width: 1rem;
    height: 1rem;
  }
  .hero-identity {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    padding: 6rem 0 8rem;
  }
  .degree {
    font-size: clamp(0.875rem, 1.5vw, 1.375rem);
    line-height: 1.5;
    letter-spacing: 0.06em;
  }
  h1 {
    margin: 1.375rem 0 1.5625rem;
    font-size: clamp(3rem, 13vw, 11.5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.065em;
    white-space: nowrap;
  }
  .university {
    font-size: clamp(1.0625rem, 2vw, 1.875rem);
    line-height: 1.5;
    letter-spacing: -0.015em;
  }
  .orbital-art {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    transform: translate(var(--orbit-x, 0px), var(--orbit-y, 0px));
    transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .orbit-path {
    --orbit-angle: -26deg;
    position: absolute;
    width: 89%;
    height: 39%;
    left: 5%;
    top: 30%;
    border: 1px solid #cdbfa990;
    border-radius: 50%;
    transform: rotate(var(--orbit-angle));
  }
  .planet {
    position: absolute;
    border-radius: 50%;
  }
  .blue-planet {
    width: clamp(6.125rem, 13vw, 11rem);
    aspect-ratio: 1;
    right: 5%;
    top: 19%;
    background: radial-gradient(circle at 30% 25%, #d2e7fc, #aacaf0 65%, #90b2da);
    box-shadow: 8px 14px 22px -17px #77889970;
  }
  .yellow-planet {
    width: clamp(3.375rem, 7.3vw, 6rem);
    aspect-ratio: 1;
    left: 6%;
    top: 64%;
    background: radial-gradient(circle at 30% 25%, #f9e5a8, #e7c777);
  }
  .pink-planet {
    width: clamp(1.6875rem, 3.65vw, 3rem);
    aspect-ratio: 1;
    right: 23%;
    bottom: 24%;
    background: radial-gradient(circle at 30% 25%, #f0d4d9, #e2b7c4);
  }
  @media (min-width: 900px) {
    .orbit-path {
      height: 65%;
      top: 17.5%;
      --orbit-angle: -16deg;
    }
  }
  @media (max-width: 540px) {
    .orbit-hero {
      min-height: 32rem;
      padding: 1.25rem 1.5rem 1.5rem;
    }
    .hero-links {
      gap: 1.5rem;
    }
    .hero-identity {
      padding: 8.25rem 0 8.375rem;
    }
    .degree {
      font-size: 0.75rem;
      letter-spacing: 0.025em;
    }
    h1 {
      margin: 1.25rem 0 1.375rem;
    }
    .orbit-path {
      width: 119%;
      height: 32%;
      left: -10%;
      top: 35%;
      --orbit-angle: -32deg;
    }
    .blue-planet {
      width: 65px;
      top: 23%;
      right: 4%;
    }
    .yellow-planet {
      width: 36px;
      top: 67%;
      left: 3%;
    }
    .pink-planet {
      width: 18px;
      bottom: 22%;
      right: 18%;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .orbit-hero[data-entrance="pending"]
      :is(.degree, h1, .university, .hero-links, .orbital-art) {
      visibility: hidden;
    }
    .orbit-hero[data-entrance="revealed"]
      :is(.degree, h1, .university, .hero-links) {
      animation: hero-slide-in 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .orbit-hero[data-entrance="revealed"] .degree {
      animation-delay: 50ms;
    }
    .orbit-hero[data-entrance="revealed"] .hero-identity h1 {
      animation-delay: 150ms;
    }
    .orbit-hero[data-entrance="revealed"] .university {
      animation-delay: 300ms;
    }
    .orbit-hero[data-entrance="revealed"] .hero-links {
      animation-delay: 450ms;
    }
    .orbit-hero[data-entrance="revealed"] .orbit-path {
      animation: orbit-unfold 1250ms cubic-bezier(0.22, 1, 0.36, 1) 450ms both;
    }
    .orbit-hero[data-entrance="revealed"] .planet {
      animation: planet-arrive 1100ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .orbit-hero[data-entrance="revealed"] .blue-planet {
      animation-delay: 550ms;
    }
    .orbit-hero[data-entrance="revealed"] .yellow-planet {
      animation-delay: 700ms;
    }
    .orbit-hero[data-entrance="revealed"] .pink-planet {
      animation-delay: 850ms;
    }
  }
  @keyframes hero-slide-in {
    from {
      opacity: 0;
      transform: translateX(-48px);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
      filter: blur(0);
    }
  }
  @keyframes orbit-unfold {
    from {
      opacity: 0;
      transform: rotate(calc(var(--orbit-angle) - 12deg)) scale(0.8);
    }
    to {
      opacity: 1;
      transform: rotate(var(--orbit-angle)) scale(1);
    }
  }
  @keyframes planet-arrive {
    from {
      opacity: 0;
      transform: translateY(40px) scale(0.7);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .orbital-art {
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>("[data-orbit-hero]")!;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  function resetMotion() {
    hero.style.setProperty("--orbit-x", "0px");
    hero.style.setProperty("--orbit-y", "0px");
  }
  hero.addEventListener("pointermove", (event) => {
    if (event.pointerType === "touch" || reducedMotion.matches) return;
    const rect = hero.getBoundingClientRect();
    hero.style.setProperty(
      "--orbit-x",
      `${((event.clientX - rect.left) / rect.width - 0.5) * 14}px`,
    );
    hero.style.setProperty(
      "--orbit-y",
      `${((event.clientY - rect.top) / rect.height - 0.5) * 14}px`,
    );
  });
  hero.addEventListener("pointerleave", resetMotion);
  hero.addEventListener("pointercancel", resetMotion);
  reducedMotion.addEventListener("change", resetMotion);
</script>
