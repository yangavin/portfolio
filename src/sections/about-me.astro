---
import { contentfulClient } from "../lib/contentful";
import { documentToHtmlString } from "@contentful/rich-text-html-renderer";
import type { EntryFieldTypes } from "contentful";
import { INLINES } from "@contentful/rich-text-types";

type paragraphs = {
  contentTypeId: "paragraphs";
  fields: {
    content: EntryFieldTypes.RichText;
  };
};

const content = await contentfulClient.getEntry<paragraphs>(
  "5AiBzb1VpHv56DVdAJBhCH",
);
---

<section class="about-me" aria-labelledby="about-me-title">
  <header class="note-heading">
    <h1 id="about-me-title">A few things about me.</h1>
  </header>
  <div
    class="personal-note"
    set:html={documentToHtmlString(content.fields.content, {
      renderNode: {
        [INLINES.HYPERLINK]: (node, next) => {
          const uri = String(node.data.uri)
            .replace(/&/g, "&amp;")
            .replace(/"/g, "&quot;")
            .replace(/</g, "&lt;");
          return `<a target="_blank" rel="noopener noreferrer" href="${uri}">${next(node.content)}</a>`;
        },
      },
    })}
  />
</section>

<style>
  .about-me {
    width: 100%;
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: 2rem;
  }
  .note-heading {
    margin-bottom: 2rem;
  }
  h1 {
    font-size: clamp(1.5rem, 5.4vw, 4.5rem);
    line-height: 1.12;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }
  .personal-note {
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid #e1d3be;
    border-radius: 24px;
    background: #fff8ec;
    font-size: clamp(1rem, 1.8vw, 1.375rem);
    line-height: 1.75;
    overflow-wrap: anywhere;
  }
  .personal-note > :global(* + *) {
    margin-top: 1.75rem;
  }
  .personal-note > :global(p:first-child) {
    font-size: clamp(1.375rem, 2.5vw, 2rem);
    line-height: 1.6;
  }
  .personal-note :global(ul) {
    list-style: none;
    padding: 0;
  }
  .personal-note :global(ul > li) {
    padding-inline-start: 1.25rem;
    border-inline-start: 3px solid #d7c598;
  }
  .personal-note :global(ul > li:nth-child(3n + 2)) {
    border-color: #b4ccc5;
  }
  .personal-note :global(ul > li:nth-child(3n + 3)) {
    border-color: #d7b9c5;
  }
  .personal-note :global(li + li),
  .personal-note :global(li > * + *) {
    margin-top: 1.5rem;
  }
  .personal-note :global(ol) {
    list-style: decimal outside;
    padding-inline-start: 1.5em;
  }
  .personal-note > :global(ul + p),
  .personal-note > :global(ol + p) {
    border-top: 1px solid #e1d3be;
    padding-top: 1.5rem;
  }
  .personal-note :global(a) {
    color: #476967;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .personal-note :global(a:hover) {
    color: #283f3d;
  }
  .personal-note :global(a:focus-visible) {
    outline: 2px solid #476967;
    outline-offset: 4px;
    border-radius: 2px;
  }
  @media (max-width: 640px) {
    .about-me {
      padding-inline: 1rem;
    }
    .personal-note {
      padding: 1.5rem 1.25rem;
    }
    .personal-note :global(ul > li) {
      padding-inline-start: 0.875rem;
    }
  }
</style>
